generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  role         UserRole     @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  dormRecords  DormRecord[]
  sessions     Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model DormRecord {
  id         String   @id @default(cuid())
  period     DateTime
  dormName   String
  totalKwh   Float
  billAmount Float
  createdBy  String? //optional
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?     @relation(fields: [createdBy], references: [id])
}

model Dorm {
  id            String   @id @default(cuid())
  name          String   @unique
  gender        Gender
  powerCapacity Int
  capacity      Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


enum Gender {
  PUTRA
  PUTRI
  CAMPUR
}

enum UserRole {
  USER
  ADMIN
}
